---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Black Systems">
	<main class="max-w-4xl mx-auto px-6 pt-40 pb-32 relative z-10">
		<div class="mb-16">
			<a href="/" class="text-xs font-mono text-neutral-500 hover:text-white transition-colors flex items-center gap-2 mb-8 w-fit">
				<span>←</span> RETURN TO INDEX
			</a>
			<h1 class="text-4xl md:text-5xl font-normal tracking-tight text-white mb-6">Get in Touch</h1>
			
			<p class="text-neutral-400 text-lg font-light leading-relaxed max-w-xl">
				Whether you're looking to scale your infrastructure, architect a new backend system, or discuss engineering patterns, I am available for new opportunities.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
			<div class="bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 relative overflow-hidden flex flex-col justify-between">
				<div class="absolute inset-0 bg-gradient-to-br from-white/[0.01] to-transparent pointer-events-none"></div>
				<div>
					<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-2">Email</span>
					<h3 class="text-2xl font-medium tracking-tight text-neutral-200 mb-2">Direct Email</h3>
					<p class="text-sm text-neutral-400 mb-8">Reach out directly for project inquiries, consulting, or technical reviews.</p>
				</div>
				<a href="mailto:okechukwuhurstin@gmail.com" class="text-white hover:text-emerald-400 transition-colors font-mono tracking-wide break-all">okechukwuhurstin@gmail.com</a>
			</div>

			<div class="bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 relative overflow-hidden flex flex-col justify-between">
				<div class="absolute inset-0 bg-gradient-to-bl from-white/[0.01] to-transparent pointer-events-none"></div>
				<div>
					<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-2">Social</span>
					<h3 class="text-2xl font-medium tracking-tight text-neutral-200 mb-2">Professional Networks</h3>
					<p class="text-sm text-neutral-400 mb-8">View my open-source contributions and work history.</p>
				</div>
				<div class="flex flex-col gap-4 font-mono text-sm relative z-10">
					<a href="https://github.com/hurstin" target="_blank" rel="noopener noreferrer" class="text-neutral-300 hover:text-white flex items-center justify-between group transition-colors">
						<span>GITHUB</span>
						<span class="text-neutral-600 group-hover:text-white transition-colors">↗</span>
					</a>
					<div class="w-full h-px bg-white/[0.03]"></div>
					<a href="https://www.linkedin.com/in/augustine-okechukwu-248566190/" target="_blank" rel="noopener noreferrer" class="text-neutral-300 hover:text-white flex items-center justify-between group transition-colors">
						<span>LINKEDIN</span>
						<span class="text-neutral-600 group-hover:text-white transition-colors">↗</span>
					</a>
				</div>
			</div>
		</div>

		<div class="mb-24 bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 md:p-12 relative overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-b from-white/[0.01] to-transparent pointer-events-none"></div>
			<div class="relative z-10">
				<div class="mb-8">
					<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-2">Contact Form</span>
					<h3 class="text-2xl font-medium tracking-tight text-neutral-200">Send a Message</h3>
				</div>
				<form id="contactForm" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
					<!-- Access key is securely loaded from .env -->
					<input type="hidden" name="access_key" value={(import.meta.env as any).PUBLIC_WEB3FORMS_ACCESS_KEY} />
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div class="space-y-2">
							<label for="name" class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest">Name</label>
							<input type="text" id="name" name="name" class="w-full bg-black/40 border border-white/[0.04] rounded-xl px-4 py-3 text-neutral-300 focus:outline-none focus:border-white/[0.12] transition-colors" placeholder="John Doe" required />
						</div>
						<div class="space-y-2">
							<label for="email" class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest">Email</label>
							<input type="email" id="email" name="email" class="w-full bg-black/40 border border-white/[0.04] rounded-xl px-4 py-3 text-neutral-300 focus:outline-none focus:border-white/[0.12] transition-colors" placeholder="john@example.com" required />
						</div>
					</div>
					<div class="space-y-2">
						<label for="message" class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest">Message</label>
						<textarea id="message" name="message" rows="5" class="w-full bg-black/40 border border-white/[0.04] rounded-xl px-4 py-3 text-neutral-300 focus:outline-none focus:border-white/[0.12] transition-colors resize-none" placeholder="How can I help you?" required></textarea>
					</div>
					<button id="submitBtn" type="submit" class="bg-white text-black text-xs font-semibold tracking-wider uppercase px-8 py-3.5 rounded-full hover:bg-neutral-200 transition-all shadow-lg shadow-white/5 w-full md:w-auto flex items-center justify-center gap-2 mt-4 disabled:opacity-50 disabled:cursor-not-allowed">
						<span id="submitText">Send Message</span> <span class="text-neutral-500 text-[10px]">→</span>
					</button>
				</form>
			</div>
		</div>

		<footer class="pt-12 border-t border-white/[0.03] flex flex-col md:flex-row justify-between items-center gap-6">
			<p class="text-xs text-neutral-500 font-mono">© 2026 Black Systems. All rights reserved.</p>
			<div class="flex gap-6 text-xs text-neutral-400 font-mono">
				<a href="https://github.com/hurstin" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GITHUB</a>
				<a href="https://www.linkedin.com/in/augustine-okechukwu-248566190/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LINKEDIN</a>
			</div>
		</footer>
	</main>
</Layout>

<script>
	const form = document.getElementById('contactForm') as HTMLFormElement;
	const button = document.getElementById('submitBtn') as HTMLButtonElement;
	const buttonText = document.getElementById('submitText') as HTMLSpanElement;

	if (form && button && buttonText) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			
			const originalText = buttonText.innerText;
			buttonText.innerText = 'Sending...';
			button.disabled = true;

			const formData = new FormData(form);
			const object = Object.fromEntries(formData);
			const json = JSON.stringify(object);

			try {
				const response = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'Accept': 'application/json'
					},
					body: json
				});

				if (response.status === 200) {
					buttonText.innerText = 'Sent Successfully!';
					form.reset();
				} else {
					buttonText.innerText = 'Error Sending';
				}
			} catch (error) {
				buttonText.innerText = 'Error Sending';
			} finally {
				setTimeout(() => {
					buttonText.innerText = originalText;
					button.disabled = false;
				}, 3000);
			}
		});
	}
</script>
