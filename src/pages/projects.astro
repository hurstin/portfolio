---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: "Insighta Backend",
		category: "Backend API",
		description: "Core backend service for the Insighta platform, handling business logic, data persistence, and API orchestration.",
		tech: ["TypeScript", "Node.js", "Express"],
		metrics: "API Service",
		link: "https://github.com/hurstin/insighta-backend"
	},
	{
		title: "Notification System",
		category: "Backend Architecture",
		description: "A scalable microservice built to reliably deliver high-volume email and push notifications asynchronously.",
		tech: ["TypeScript", "Node.js", "NestJS"],
		metrics: "Microservice",
		link: "https://github.com/hurstin/notification-system"
	},
	{
		title: "Auth System",
		category: "Security",
		description: "A centralized authentication provider supporting secure access control, token management, and identity verification.",
		tech: ["TypeScript", "JWT", "NestJS"],
		metrics: "Identity Access",
		link: "https://github.com/hurstin/authSystem"
	},
	{
		title: "Drip Haven Backend",
		category: "Backend API",
		description: "The core backend infrastructure for the Drip Haven application, managing washers, cust	omers, orders, payments and more.",
		tech: ["TypeScript", "Node.js", "NestJS"],
		metrics: "REST API",
		link: "https://github.com/hurstin/Drip-haven-backend"
	}
];
---

<Layout title="Projects | Black Systems">
	<main class="max-w-6xl mx-auto px-6 pt-40 pb-32 relative z-10">
		<div class="mb-16 flex flex-col items-center text-center md:items-start md:text-left">
			<a href="/" class="text-xs font-mono text-neutral-500 hover:text-white transition-colors flex items-center gap-2 mb-8 w-fit">
				<span>←</span> RETURN TO INDEX
			</a>
			<h1 class="text-4xl md:text-5xl font-normal tracking-tight text-white mb-4">Projects</h1>
			<p class="text-neutral-400 text-sm md:text-base font-light max-w-xl">
				An overview of backend systems, microservices, and APIs I've built and deployed.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			{projects.map((project) => (
				<a href={project.link} class="bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 flex flex-col justify-between hover:border-white/[0.12] hover:bg-white/[0.02] transition-all duration-500 group relative overflow-hidden block">
					<div class="absolute inset-0 bg-gradient-to-br from-white/[0.01] to-transparent pointer-events-none"></div>
					
					<div class="mb-8">
						<div class="flex justify-between items-start mb-6">
							<div>
								<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-1">{project.category}</span>
								<h3 class="text-lg font-medium tracking-tight text-neutral-200">{project.title}</h3>
							</div>
							<div class="w-8 h-8 rounded-full bg-white/[0.03] border border-white/5 flex items-center justify-center text-neutral-500 group-hover:text-white group-hover:bg-white/10 transition-all duration-300 text-sm">↗</div>
						</div>
						<p class="text-neutral-400 text-xs font-light leading-relaxed">
							{project.description}
						</p>
					</div>

					<div class="mt-auto pt-6 border-t border-white/[0.03]">
						<div class="flex justify-between items-end mb-4">
							<div class="flex flex-wrap gap-2">
								{project.tech.map((t) => (
									<span class="px-2 py-1 bg-white/[0.03] border border-white/[0.05] rounded-md text-[10px] font-mono text-neutral-400">{t}</span>
								))}
							</div>
						</div>
						<div class="font-mono text-[9px] text-neutral-500 flex justify-between items-center">
							<span>METRICS</span>
							<span class="text-emerald-400/80">{project.metrics}</span>
						</div>
					</div>
				</a>
			))}
		</div>

		<footer class="mt-32 pt-12 border-t border-white/[0.03] flex flex-col md:flex-row justify-between items-center gap-6">
			<p class="text-xs text-neutral-500 font-mono">© 2026 Black Systems. All rights reserved.</p>
			<div class="flex gap-6 text-xs text-neutral-400 font-mono">
				<a href="https://github.com/hurstin" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GITHUB</a>
				<a href="https://www.linkedin.com/in/augustine-okechukwu-248566190/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LINKEDIN</a>
			</div>
		</footer>
	</main>
</Layout>
