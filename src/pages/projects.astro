---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: "BeReside Hotel Management System",
		category: "Fullstack Application",
		description: "A production-ready hotel management and booking platform featuring real-time room availability, secure payments, and a role-based admin dashboard.",
		tech: ["Next.js", "NestJS", "PostgreSQL"],
		metrics: "Booking System",
		github: "https://github.com/hurstin/BeReside",
		live: "https://bereside-frontend.onrender.com",
		api: "https://bereside-api.onrender.com/api"
	},
	{
		title: "Insighta Backend",
		category: "Backend API",
		description: "Core backend service for the Insighta platform, handling business logic, data persistence, and API orchestration.",
		tech: ["TypeScript", "Node.js", "Express"],
		metrics: "API Service",
		github: "https://github.com/hurstin/insighta-backend"
	},
	{
		title: "Notification System",
		category: "Backend Architecture",
		description: "A scalable microservice built to reliably deliver high-volume email and push notifications asynchronously.",
		tech: ["TypeScript", "Node.js", "NestJS"],
		metrics: "Microservice",
		github: "https://github.com/hurstin/notification-system"
	},
	{
		title: "Auth System",
		category: "Security",
		description: "A centralized authentication provider supporting secure access control, token management, and identity verification.",
		tech: ["TypeScript", "JWT", "NestJS"],
		metrics: "Identity Access",
		github: "https://github.com/hurstin/authSystem"
	},
	{
		title: "Drip Haven Backend",
		category: "Backend API",
		description: "The core backend infrastructure for the Drip Haven application, managing washers, cust	omers, orders, payments and more.",
		tech: ["TypeScript", "Node.js", "NestJS"],
		metrics: "REST API",
		github: "https://github.com/hurstin/Drip-haven-backend"
	}
];
---

<Layout title="Projects | Black Systems">
	<main class="max-w-6xl mx-auto px-6 pt-40 pb-32 relative z-10">
		<div class="mb-16 flex flex-col items-center text-center md:items-start md:text-left">
			<a href="/" class="text-xs font-mono text-neutral-500 hover:text-white transition-colors flex items-center gap-2 mb-8 w-fit">
				<span>←</span> RETURN TO INDEX
			</a>
			<h1 class="text-4xl md:text-5xl font-normal tracking-tight text-white mb-4">Projects</h1>
			<p class="text-neutral-400 text-sm md:text-base font-light max-w-xl">
				An overview of backend systems, microservices, and APIs I've built and deployed.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			{projects.map((project) => (
				<div class="bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 flex flex-col justify-between hover:border-white/[0.12] transition-all duration-500 group relative overflow-hidden block">
					<div class="absolute inset-0 bg-gradient-to-br from-white/[0.01] to-transparent pointer-events-none"></div>
					
					<div class="mb-8">
						<div class="flex justify-between items-start mb-6 gap-2">
							<div>
								<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-1">{project.category}</span>
								<h3 class="text-lg font-medium tracking-tight text-neutral-200">{project.title}</h3>
							</div>
							<div class="flex gap-2">
								{project.github && (
									<a href={project.github} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/[0.03] border border-white/5 flex items-center justify-center text-neutral-500 hover:text-white hover:bg-white/10 transition-all duration-300 text-sm" title="GitHub Repository">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
									</a>
								)}
								{project.live && (
									<a href={project.live} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/[0.03] border border-white/5 flex items-center justify-center text-neutral-500 hover:text-white hover:bg-white/10 transition-all duration-300 text-sm" title="Live Site">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
									</a>
								)}
								{project.api && (
									<a href={project.api} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/[0.03] border border-white/5 flex items-center justify-center text-neutral-500 hover:text-white hover:bg-white/10 transition-all duration-300 text-sm" title="API / Backend">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l3-9 5 18 3-9h5"/></svg>
									</a>
								)}
							</div>
						</div>
						<p class="text-neutral-400 text-xs font-light leading-relaxed">
							{project.description}
						</p>
					</div>

					<div class="mt-auto pt-6 border-t border-white/[0.03]">
						<div class="flex justify-between items-end mb-4">
							<div class="flex flex-wrap gap-2">
								{project.tech.map((t) => (
									<span class="px-2 py-1 bg-white/[0.03] border border-white/[0.05] rounded-md text-[10px] font-mono text-neutral-400">{t}</span>
								))}
							</div>
						</div>
						<div class="font-mono text-[9px] text-neutral-500 flex justify-between items-center">
							<span>METRICS</span>
							<span class="text-emerald-400/80">{project.metrics}</span>
						</div>
					</div>
				</div>
			))}
		</div>

		<footer class="mt-32 pt-12 border-t border-white/[0.03] flex flex-col md:flex-row justify-between items-center gap-6">
			<p class="text-xs text-neutral-500 font-mono">© 2026 Black Systems. All rights reserved.</p>
			<div class="flex gap-6 text-xs text-neutral-400 font-mono">
				<a href="https://github.com/hurstin" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GITHUB</a>
				<a href="https://www.linkedin.com/in/augustine-okechukwu-248566190/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LINKEDIN</a>
			</div>
		</footer>
	</main>
</Layout>
