---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Journal | Black Systems">
	<main class="max-w-4xl mx-auto px-6 pt-40 pb-32 relative z-10 min-h-[80vh] flex flex-col">
		<div class="mb-16">
			<a href="/" class="text-xs font-mono text-neutral-500 hover:text-white transition-colors flex items-center gap-2 w-fit">
				<span>←</span> RETURN TO INDEX
			</a>
		</div>

		<div class="flex-grow flex items-center justify-center">
			<div class="text-center font-mono tracking-[0.3em] uppercase text-neutral-500 text-lg">
				Coming Soon
			</div>
		</div>
	</main>
</Layout>
