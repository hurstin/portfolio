---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Black | Backend Architect">
	<main class="max-w-6xl mx-auto px-6 pt-40 pb-32 relative z-10">
		
		<section class="flex flex-col items-center text-center mb-32 max-w-3xl mx-auto">
			<div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-white/[0.06] bg-white/[0.02] mb-8 backdrop-blur-sm">
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
				</span>
				<span class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 font-mono font-medium">Available for new projects</span>
			</div>
			
			<h1 class="text-6xl md:text-8xl mb-8 tracking-tight leading-[0.95] text-white font-normal">
				I build backend systems with <br /><span class="italic font-light text-neutral-400">Node.js</span> and <span class="italic font-light text-neutral-400">NestJS.</span>
			</h1>
			
			<p class="text-neutral-400 text-base md:text-lg leading-relaxed mb-10 max-w-xl font-light">
				I focus on making APIs fast, keeping data secure, and ensuring servers stay up when traffic spikes.
			</p>

			<div class="flex flex-col items-center gap-8">
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto px-4 sm:px-0">
					<a href="/projects" class="w-full sm:w-auto text-center bg-white text-black text-xs font-semibold tracking-wider uppercase px-6 py-3.5 rounded-full hover:bg-neutral-200 transition-all shadow-lg shadow-white/5">
						View Projects
					</a>
					<a href="/resume.pdf" download="Okechukwu_Augustine_CV.pdf" class="w-full sm:w-auto justify-center bg-white text-black text-xs font-semibold tracking-wider uppercase px-6 py-3.5 rounded-full hover:bg-neutral-200 transition-all shadow-lg shadow-white/5 flex items-center gap-2">
						Download Resume
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
					</a>
				</div>
				<div class="flex flex-wrap items-center justify-center gap-6">
					<a href="https://github.com/hurstin" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors" aria-label="GitHub Profile">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
					</a>
					<a href="https://www.linkedin.com/in/augustine-okechukwu-248566190/" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors" aria-label="LinkedIn Profile">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
					</a>
					<a href="https://x.com/hurstin_" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors" aria-label="X Profile">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
					</a>
					<a href="https://wa.me/2349068233270" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors" aria-label="WhatsApp">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="50 50 540 540"><path d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1L319.9 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1zM319.9 502.7C286.7 502.7 254.2 493.8 225.9 477L219.2 473L149.4 491.3L168 423.2L163.6 416.2C145.1 386.8 135.4 352.9 135.4 318C135.4 216.3 218.2 133.5 320 133.5C369.3 133.5 415.6 152.7 450.4 187.6C485.2 222.5 506.6 268.8 506.5 318.1C506.5 419.9 421.6 502.7 319.9 502.7zM421.1 364.5C415.6 361.7 388.3 348.3 383.2 346.5C378.1 344.6 374.4 343.7 370.7 349.3C367 354.9 356.4 367.3 353.1 371.1C349.9 374.8 346.6 375.3 341.1 372.5C308.5 356.2 287.1 343.4 265.6 306.5C259.9 296.7 271.3 297.4 281.9 276.2C283.7 272.5 282.8 269.3 281.4 266.5C280 263.7 268.9 236.4 264.3 225.3C259.8 214.5 255.2 216 251.8 215.8C248.6 215.6 244.9 215.6 241.2 215.6C237.5 215.6 231.5 217 226.4 222.5C221.3 228.1 207 241.5 207 268.8C207 296.1 226.9 322.5 229.6 326.2C232.4 329.9 268.7 385.9 324.4 410C359.6 425.2 373.4 426.5 391 423.9C401.7 422.3 423.8 410.5 428.4 397.5C433 384.5 433 373.4 431.6 371.1C430.3 368.6 426.6 367.2 421.1 364.5z"/></svg>
					</a>
					<a href="https://instagram.com/hurssttinn" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors" aria-label="Instagram Profile">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
					</a>
				</div>
			</div>
		</section>

		<section id="work" class="space-y-4">
			<div class="flex items-baseline justify-between mb-8 border-b border-white/[0.04] pb-4">
				<h2 class="text-3xl font-normal tracking-tight text-neutral-300">Selected Projects</h2>
				<span class="font-mono text-[10px] text-neutral-500 tracking-widest uppercase">Featured Work</span>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				
				<a href="https://github.com/hurstin/insighta-backend" target="_blank" rel="noopener noreferrer" class="md:col-span-2 group bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 flex flex-col justify-between hover:border-white/[0.12] transition-all duration-500 relative overflow-hidden block">
					<div class="absolute inset-0 bg-gradient-to-br from-white/[0.01] to-transparent pointer-events-none"></div>
					
					<div>
						<div class="flex justify-between items-start mb-6">
							<div>
								<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-1">Backend API</span>
								<h3 class="text-xl font-medium tracking-tight text-neutral-200">Drip Haven Backend</h3>
							</div>
							<div class="w-8 h-8 rounded-full bg-white/[0.03] border border-white/5 flex items-center justify-center text-neutral-500 group-hover:text-white group-hover:bg-white/10 transition-all duration-300 text-sm">↗</div>
						</div>
						<p class="text-neutral-400 text-sm font-light max-w-xl mb-8 leading-relaxed">
							Core backend service for the Drip Haven platform, handling business logic, data persistence, washers, customers, orders, payments and more
						</p>
					</div>

					<div class="mt-auto pt-6 border-t border-white/[0.03]">
						<div class="grid grid-cols-3 gap-4 font-mono">
							<div>
								<span class="text-[9px] text-neutral-500 block uppercase tracking-wider">Language</span>
								<span class="text-xs text-neutral-300 font-medium">TypeScript</span>
							</div>
							<div>
								<span class="text-[9px] text-neutral-500 block uppercase tracking-wider">Runtime</span>
								<span class="text-xs text-neutral-300 font-medium">Node.js, NestJS</span>
							</div>
							<div>
								<span class="text-[9px] text-emerald-500/80 block uppercase tracking-wider">Metrics</span>
								<span class="text-xs text-emerald-400 font-medium">REST API</span>
							</div>
						</div>
					</div>
				</a>

				<div class="bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 flex flex-col justify-between hover:border-white/[0.12] transition-all duration-500 relative overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-b from-white/[0.01] to-transparent pointer-events-none"></div>
					
					<div>
						<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-4">Core Technologies</span>
						<h3 class="text-lg font-medium tracking-tight text-neutral-200 mb-6">My Tech Stack</h3>
						
						<div class="space-y-3.5">
							{['TypeScript & Node.js', 'React & Vite', 'PostgreSQL & Redis', 'Docker & CI/CD', 'REST APIs & JWT','NestJS'].map((tech, i) => (
								<div class="flex items-center gap-3">
									<span class={`w-1 h-1 rounded-full ${i === 0 ? 'bg-white' : 'bg-neutral-600'}`}></span>
									<span class="text-xs font-light text-neutral-400 tracking-wide">{tech}</span>
								</div>
							))}
						</div>
					</div>
					
					<div class="pt-6 border-t border-white/[0.03] font-mono text-[9px] text-neutral-500 flex justify-between items-center">
						<span>EXPERTISE</span>
						<span class="text-neutral-400">Current</span>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				

				<div class="bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 flex flex-col justify-between hover:border-white/[0.12] transition-all duration-500 text-left relative overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-tr from-white/[0.01] to-transparent pointer-events-none"></div>
					<div>
						<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-1">Experience</span>
						<h3 class="text-lg font-medium tracking-tight text-neutral-200 mb-6">Professional Background</h3>
					</div>
					<div class="my-auto">
						<span class="text-5xl font-serif text-white tracking-tighter block mb-1">1+ <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase">Years</span></span>
					</div>
					<div class="pt-4 border-t border-white/[0.03] font-mono text-[9px] text-neutral-500">
						<span>INDUSTRY EXPERIENCE</span>
					</div>
				</div>

				<a href="https://github.com/hurstin/authSystem" target="_blank" rel="noopener noreferrer" class="bg-[#0e0e10] border border-white/[0.04] rounded-3xl p-8 flex flex-col justify-between hover:border-white/[0.12] transition-all duration-500 group block">
					<div>
						<div class="flex justify-between items-start mb-6">
							<div>
								<span class="font-mono text-[9px] text-neutral-500 tracking-widest uppercase block mb-1">Security</span>
								<h3 class="text-lg font-medium tracking-tight text-neutral-200">Auth System</h3>
							</div>
							<span class="text-neutral-600 group-hover:text-white transition-colors text-sm">↗</span>
						</div>
						<p class="text-neutral-400 text-xs font-light leading-relaxed mb-6">
							A centralized authentication provider supporting secure access control, token management, and identity verification.
						</p>
					</div>
					<div class="pt-4 border-t border-white/[0.03] font-mono text-[10px] text-neutral-500 flex justify-between">
						<span>REST API</span>
						<span class="text-neutral-300">TypeScript</span>
					</div>
				</a>
			</div>
		</section>

		<footer class="mt-32 pt-12 border-t border-white/[0.03] flex flex-col md:flex-row justify-between items-center gap-6">
			<p class="text-xs text-neutral-500 font-mono">© 2026 Black Systems. All rights reserved.</p>
			<div class="flex gap-6 text-xs text-neutral-400 font-mono">
				<a href="https://github.com/hurstin" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GITHUB</a>
				<a href="https://www.linkedin.com/in/augustine-okechukwu-248566190/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LINKEDIN</a>
			</div>
		</footer>

	</main>
</Layout>